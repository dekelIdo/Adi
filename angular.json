{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "landing-page": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/landing-page",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets",
                "ignore": [
                  "lovable-uploads/MyAssets/AdiArieli/AdiArieli/**",
                  "lovable-uploads/MyAssets/AdiArieli/DESIGN_REFERENCES/**",
                  "lovable-uploads/MyAssets/AdiArieli/avivozeri *.jpg",
                  "lovable-uploads/MyAssets/AdiArieli/Me*.jpg",
                  "lovable-uploads/MyAssets/AdiArieli/ChatGPT Image *.png",
                  "lovable-uploads/MyAssets/AdiArieli/Cemantic use with the iphone animation live feature.png",
                  "lovable-uploads/MyAssets/AdiArieli/ready_new elemetofAdiWithCamera.png",
                  "lovable-uploads/MyAssets/AdiArieli/Iphone black clean.png",
                  "lovable-uploads/MyAssets/AdiArieli/CLAUDE-CORRECTION.md",
                  "lovable-uploads/MyAssets/MyProjects/IMG_6456.MOV",
                  "lovable-uploads/MyAssets/MyProjects/1.mp4",
                  "lovable-uploads/MyAssets/MyProjects/9.mp4",
                  "lovable-uploads/MyAssets/ContactMe.jpg",
                  "lovable-uploads/MyAssets/Signing/Adi_sign_final_image_to_prod.png",
                  "lovable-uploads/MyAssets/Signing/adi-signing-rear-view-large-contract.png",
                  "lovable-uploads/MyAssets/Signing/adi-arieli-private-sign-final-mobile.png",
                  "lovable-uploads/MyAssets/Signing/social-li visiin.png",
                  "lovable-uploads/MyAssets/Signing/adi-signing-authentic-original-head-final.png",
                  "lovable-uploads/ContactMe.jpg",
                  "lovable-uploads/IMG_1707 *.jpg",
                  "lovable-uploads/IMG_1726.jpg",
                  "lovable-uploads/avivozeri 820 *.jpg",
                  "lovable-uploads/light_to_header_dark_position.png"
                ]
              },
              "src/robots.txt",
              "src/sitemap.xml"
            ],
            "styles": ["src/styles.css"],
            "scripts": []
          },
          "configurations": {
            "development": {
              "optimization": false,
              "sourceMap": true,
              "namedChunks": true,
              "extractLicenses": false
            },
            "production": {
              "outputHashing": "all"
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "landing-page:build:development"
          },
          "configurations": {
            "development": {
              "buildTarget": "landing-page:build:development"
            },
            "production": {
              "buildTarget": "landing-page:build:production"
            }
          }
        }
      }
    }
  }
}